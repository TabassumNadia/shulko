# Copy this file to .env and fill in your own keys.
# .env is gitignored. Never commit real keys.

# ---------------------------------------------------------------- LangSmith
# Key:     https://smith.langchain.com/settings  ->  API Keys  ->  Create
#          (Personal Access Token; it is shown ONCE, copy it immediately)
# Project: created automatically on the first trace. Do not create it by hand.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=shulko
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ------------------------------------------------------------------- Gemini
# Free key: https://aistudio.google.com/apikey
# Used for three things: vision OCR, classification, and Google Search
# grounding. Nothing runs without it.
GOOGLE_API_KEY=

# ------------------------------------------------------- optional fallbacks
# Fallback for the Regulatory agent when Gemini's native google_search
# grounding is unavailable -- which on a free key mostly means its own
# daily grounding quota is spent, separate from the request quota above.
#
# Worth setting before a demo: without it, an exhausted grounding quota
# means the run still completes and simply carries no advisories.
# Free key (1,000 searches/month): https://app.tavily.com
TAVILY_API_KEY=

# ------------------------------------------------------------------- models
# Google retires embedding models (text-embedding-004 is gone). If you see
# a 404 from embedContent, set the current model id here rather than
# editing code. Newest at time of writing: models/gemini-embedding-2
# Check what your key can actually reach:  python -m backend.core.llm
# CHAT_MODEL is the one id that changes the OUTPUT and not just the speed:
# -lite fills flat schemas fine but usually returns the classifier's nested
# citation list empty, so notes stop being quoted even though they were
# retrieved and supplied. Use flash here whenever its daily quota allows.
CHAT_MODEL=gemini-3.5-flash
VISION_MODEL=gemini-3.5-flash
# JUDGE_MODEL is deliberately a DIFFERENT id from CHAT_MODEL, not a
# leftover. Google meters quota per model, so a separate id gives the
# verifier its own budget instead of eating the classifier's. Its schema is
# flat, so -lite handles it reliably. Set it to gemini-3.5-flash if you
# would rather have one model and one shared budget.
JUDGE_MODEL=gemini-3.5-flash-lite
GROUNDING_MODEL=gemini-3.5-flash
EMBEDDING_MODEL=models/gemini-embedding-001

# Embeddings run locally by default. The Gemini free tier allows only 100
# embedding requests a minute, and spending that on 7,154 static tariff
# rows starves the agents that actually need it.
#   fastembed  local ONNX, ~90 MB first run, no quota   <- default
#   google     the API, slow and quota-limited
EMBEDDING_PROVIDER=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# ------------------------------------------------------------------ storage
DATABASE_URL=sqlite:///./shulko.db
CHROMA_DIR=./data/chroma

# ------------------------------------------------------------------- quota
# The Gemini free tier allows 5 generateContent requests a minute, PER
# MODEL. One invoice needs far more than five calls and the graph runs
# line items concurrently, so without pacing the run dies partway with
# a 429 -- the single most common way this pipeline fails.
#
# Every call passes through a token bucket sized from this number, one
# bucket per model id (which is how Google meters it). Raise it if your
# key is on a paid tier and the whole pipeline gets faster with no code
# change. Lower it if you still see 429s.
GEMINI_RPM=5

# Line items worked on at once. Keep at or below GEMINI_RPM: more
# threads than the quota allows just means longer queues.
MAX_WORKERS=3

# A 429 that slips past the bucket is retried this many times, waiting
# the delay the API itself asks for. Non-quota errors are never retried.
LLM_MAX_ATTEMPTS=4

# Seconds before a single model call is abandoned. Long enough for a
# vision call on a full-page invoice, short enough that a stalled request
# surfaces as an error instead of an endless spinner.
LLM_TIMEOUT=90

# Grounded search is the slowest call in the pipeline, so it runs once
# per distinct HS code rather than once per line item, and only for the
# first few. Searching deeper also measured *worse* factual accuracy
# (arXiv 2605.06635), so this cap is an accuracy choice as well.
MAX_REGULATORY_CHECKS=2

# ----------------------------------------------------------------- behaviour
DEFAULT_LANGUAGE=en
CONFIDENCE_THRESHOLD=0.65
MAX_LINE_ITEMS=10
